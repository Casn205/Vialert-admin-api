PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Orígenes permitidos para CORS, separados por comas (la web en desarrollo usa Vite).
CORS_ORIGINS=http://localhost:5173

# Mismo proyecto Firebase que la app móvil y la web.
FIREBASE_PROJECT_ID=

# Credenciales de Admin SDK: el JSON de la cuenta de servicio en una sola línea...
FIREBASE_SERVICE_ACCOUNT_JSON=
# ...o la ruta al archivo (si dejas el JSON vacío).
GOOGLE_APPLICATION_CREDENTIALS=

# Se usan desde la Fase 3 (KPIs).
TZ_OPERACION=America/Bogota
KPI_UMBRAL_RESPUESTA_SEG=600
